{
  "manifest_version": 3,
  "name": "JobFinder AI & Auto-Apply Pilot",
  "version": "1.1.0",
  "description": "Review-based, resume-grounded application form assistance. No automatic submission.",
  "action": {
    "default_popup": "index.html"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "content_scripts": [],
  "permissions": [
    "storage",
    "activeTab",
    "clipboardRead",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "https://jobfinder-backend.onrender.com/*",
    "https://mail.google.com/*",
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "form-engine.js"
      ]
    }
  ]
}
