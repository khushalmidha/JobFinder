{
  "manifest_version": 3,
  "name": "JobFinder AI & Auto-Apply Pilot",
  "version": "1.0.0",
  "description": "Auto-detects role, company, estimated SDE1 CTC/Base, best resume matching, and humanoid auto-fill with Email OTP extraction.",
  "action": {
    "default_popup": "index.html"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "clipboardRead",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "https://jobfinder-backend.onrender.com/*",
    "https://mail.google.com/*",
    "<all_urls>"
  ]
}
