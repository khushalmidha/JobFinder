{
  "manifest_version": 3,
  "name": "ColdMail Pilot",
  "version": "1.0.0",
  "description": "Capture emails and send template outreach instantly",
  "action": {
    "default_popup": "index.html"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "activeTab",
    "clipboardRead",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "https://jobfinder-backend.onrender.com/*",
    "https://mail.google.com/*"
  ]
}
